  m_text: "\u0412\u0432\u0435\u0434\u0435\u043D\u0438\u0435\r\n\u041D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435
    \u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u043E\u0435
    \u0441\u043E\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u0435 (\xAB\u0421\u043E\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u0435\xBB)
    \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0441\u043E\u0431\u043E\u0439
    \u044E\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043A\u0438 \u043E\u0431\u044F\u0437\u044B\u0432\u0430\u044E\u0449\u0438\u0439
    \u0434\u043E\u0433\u043E\u0432\u043E\u0440 \u043C\u0435\u0436\u0434\u0443 \u0432\u0430\u043C\u0438
    (\xAB\u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\xBB)
    \u0438 \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A\u0430\u043C\u0438
    \u0438\u0433\u0440\u044B \u201CIvan Petrovich Goes To America\u201D (\u041F\u0430\u043D\u0438\u0447
    \u041C\u0430\u0440\u043A \u0412\u043B\u0430\u0434\u0438\u0441\u043B\u0430\u0432\u043E\u0432\u0438\u0447
    \u2013 \u201CByPanichMark\u201D - \xAB\u0420\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A\xBB).
    \r\n\u041D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435 \u0421\u043E\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u0435
    \u0432\u0441\u0442\u0443\u043F\u0430\u0435\u0442 \u0432 \u0441\u0438\u043B\u0443
    \u043C\u043E\u043C\u0435\u043D\u0442\u0430 \u043F\u043E\u0434\u043F\u0438\u0441\u0430\u043D\u0438\u044F
    \u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442 \u043D\u0430 \u043F\u0440\u043E\u0442\u044F\u0436\u0435\u043D\u0438\u0438
    \u0432\u0441\u0435\u0439 \u0434\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
    \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F \u0438\u0433\u0440\u044B,
    \u0432\u043A\u043B\u044E\u0447\u0430\u044F \u043F\u043E\u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435
    \u0437\u0430\u043F\u0443\u0441\u043A\u0438 \u0438\u0441\u043F\u043E\u043B\u043D\u044F\u0435\u043C\u043E\u0433\u043E
    \u0444\u0430\u0439\u043B\u0430 \u0438\u0433\u0440\u044B. \u041F\u043E\u0434\u043F\u0438\u0441\u0430\u0432
    \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0432 \u0438\u0433\u0440\u0430\u0442\u044C,
    \u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442
    \u043F\u043E\u043B\u043D\u043E\u0435 \u0438 \u0431\u0435\u0437\u043E\u0433\u043E\u0432\u043E\u0440\u043E\u0447\u043D\u043E\u0435
    \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u0435 \u0441\u043E \u0432\u0441\u0435\u043C\u0438
    \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u043C\u0438 \u0434\u0430\u043D\u043D\u043E\u0433\u043E
    \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430. \u0415\u0441\u043B\u0438
    \u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C \u043D\u0435
    \u0441\u043E\u0433\u043B\u0430\u0441\u0435\u043D \u0441 \u043A\u0430\u043A\u0438\u043C-\u043B\u0438\u0431\u043E
    \u0438\u0437 \u043F\u0443\u043D\u043A\u0442\u043E\u0432, \u0432\u044B \u043E\u0431\u044F\u0437\u0430\u043D\u044B
    \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E \u043F\u0440\u0435\u043A\u0440\u0430\u0442\u0438\u0442\u044C
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435
    \u041F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u043D\u043E\u0433\u043E \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u0438\u044F
    \u0438 \u0443\u0434\u0430\u043B\u0438\u0442\u044C \u0432\u0441\u0435 \u0441\u0432\u044F\u0437\u0430\u043D\u043D\u044B\u0435
    \u0441 \u043D\u0438\u043C \u0444\u0430\u0439\u043B\u044B.\r\n\u0414\u043E\u0441\u0442\u0443\u043F
    \u043A \u0438\u0433\u0440\u043E\u0432\u043E\u043C\u0443 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0443
    \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u0438\u0441\u043A\u043B\u044E\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E
    \u043F\u0440\u0438 \u0443\u0441\u043B\u043E\u0432\u0438\u0438 \u0432\u0430\u0448\u0435\u0433\u043E
    \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u044F \u0441 \u0434\u0430\u043D\u043D\u044B\u043C\u0438
    \u043F\u0440\u0430\u0432\u0438\u043B\u0430\u043C\u0438. \u041D\u0430\u0436\u0438\u043C\u0430\u044F
    \u043A\u043D\u043E\u043F\u043A\u0443 \xAB\u041F\u0440\u0438\u043D\u044F\u0442\u044C\xBB
    \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0443
    \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u044F \u043F\u043E\u0441\u043B\u0435
    \u044D\u043A\u0440\u0430\u043D\u0430 \u0438\u043D\u0438\u0446\u0438\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u0438,
    \u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442
    \u0441\u0432\u043E\u0435 \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u043E\u043B\u0435\u0442\u0438\u0435
    \u0438 \u0434\u0435\u0435\u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C
    \u043B\u0438\u0431\u043E \u043D\u0430\u043B\u0438\u0447\u0438\u0435 \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u044F
    \u0432\u0430\u0448\u0438\u0445 \u0437\u0430\u043A\u043E\u043D\u043D\u044B\u0445
    \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043B\u0435\u0439.\r\n1.
    \u041B\u0438\u0446\u0435\u043D\u0437\u0438\u044F \u043D\u0430 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435,
    \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u0439 \u0438\u0441\u0445\u043E\u0434\u043D\u044B\u0439
    \u043A\u043E\u0434 \u0438 \u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u0435
    \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u044B\r\n1.1. \u0418\u0441\u0445\u043E\u0434\u043D\u044B\u0439
    \u043A\u043E\u0434 \u0418\u0433\u0440\u044B \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u044F\u0435\u0442\u0441\u044F
    \u043F\u043E\u0434 \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u0435\u0439 MIT
    License. \u042D\u0442\u043E \u0434\u0430\u0435\u0442 \u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044E
    \u043F\u0440\u0430\u0432\u043E \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u043E
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C, \u043A\u043E\u043F\u0438\u0440\u043E\u0432\u0430\u0442\u044C,
    \u0438\u0437\u043C\u0435\u043D\u044F\u0442\u044C, \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u044F\u0442\u044C,
    \u043F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u0442\u044C, \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u044F\u0442\u044C,
    \u0441\u0443\u0431\u043B\u0438\u0446\u0435\u043D\u0437\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u0438 \u043F\u0440\u043E\u0434\u0430\u0432\u0430\u0442\u044C \u043A\u043E\u043F\u0438\u0438
    \u041F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u043D\u043E\u0433\u043E \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u0438\u044F
    \u043F\u0440\u0438 \u0441\u043E\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0438
    \u0443\u0441\u043B\u043E\u0432\u0438\u0439 \u043E\u0440\u0438\u0433\u0438\u043D\u0430\u043B\u044C\u043D\u043E\u0439
    \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u0438 (\u0432\u043A\u043B\u044E\u0447\u0430\u044F
    \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435 \u0443\u0432\u0435\u0434\u043E\u043C\u043B\u0435\u043D\u0438\u044F
    \u043E\u0431 \u0430\u0432\u0442\u043E\u0440\u0441\u043A\u0438\u0445 \u043F\u0440\u0430\u0432\u0430\u0445).\r\n1.2.
    \u041E\u0440\u0438\u0433\u0438\u043D\u0430\u043B\u044C\u043D\u044B\u0435 \u0445\u0443\u0434\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435
    \u0430\u0441\u0441\u0435\u0442\u044B (3D \u043C\u043E\u0434\u0435\u043B\u0438,
    \u0442\u0435\u043A\u0441\u0442\u0443\u0440\u044B), \u0441\u043E\u0437\u0434\u0430\u043D\u043D\u044B\u0435
    \u0420\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A\u043E\u043C
    \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E \u0434\u043B\u044F
    \u0434\u0430\u043D\u043D\u043E\u0433\u043E \u043F\u0440\u043E\u0435\u043A\u0442\u0430,
    \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u044F\u044E\u0442\u0441\u044F
    \u043F\u043E\u0434 \u043C\u0435\u0436\u0434\u0443\u043D\u0430\u0440\u043E\u0434\u043D\u043E\u0439
    \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u0435\u0439 Creative Commons Attribution
    4.0 International (CC BY 4.0). \u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C
    \u043C\u043E\u0436\u0435\u0442 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u0438\u0445
    \u0432 \u043B\u044E\u0431\u044B\u0445 \u0446\u0435\u043B\u044F\u0445 \u043F\u0440\u0438
    \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u043C \u0443\u043A\u0430\u0437\u0430\u043D\u0438\u0438
    \u0430\u0432\u0442\u043E\u0440\u0441\u0442\u0432\u0430 \u0420\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A\u0430
    (Attribution).\r\n1.3. \u0418\u0433\u0440\u0430 \u0432\u043A\u043B\u044E\u0447\u0430\u0435\u0442
    \u0432 \u0441\u0435\u0431\u044F \u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u0439
    \u043A\u043E\u0434 (Third Party Code) \u0438 \u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u0435
    \u0430\u0441\u0441\u0435\u0442\u044B (Third Party Assets \u2014 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u043D\u044B\u0435
    \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0438, \u043F\u043B\u0430\u0433\u0438\u043D\u044B,
    \u0448\u0440\u0438\u0444\u0442\u044B, \u0437\u0432\u0443\u043A\u043E\u0432\u044B\u0435
    \u044D\u0444\u0444\u0435\u043A\u0442\u044B \u043E\u0442 \u043D\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043C\u044B\u0445
    \u0430\u0432\u0442\u043E\u0440\u043E\u0432). \u041F\u0440\u0430\u0432\u0430 \u043D\u0430
    \u0442\u0430\u043A\u0438\u0435 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u044B
    \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0430\u0442 \u0438\u0445
    \u043F\u0435\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u044B\u043C
    \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0430\u043C. \u0423\u0441\u043B\u043E\u0432\u0438\u044F
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F
    \u044D\u0442\u0438\u0445 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u043E\u0432
    \u0440\u0435\u0433\u0443\u043B\u0438\u0440\u0443\u044E\u0442\u0441\u044F \u0438\u0445
    \u0438\u043D\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043B\u044C\u043D\u044B\u043C\u0438
    \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u044F\u043C\u0438. \u041F\u043E\u043B\u043D\u044B\u0439
    \u043F\u0435\u0440\u0435\u0447\u0435\u043D\u044C \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u043D\u044B\u0445
    \u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u0445 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u043E\u0432,
    \u0438\u0445 \u0430\u0432\u0442\u043E\u0440\u043E\u0432 \u0438 \u043F\u0440\u0438\u043C\u0435\u043D\u0438\u043C\u044B\u0435
    \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u0438 \u0443\u043A\u0430\u0437\u0430\u043D\u044B
    \u0432 \u0444\u0430\u0439\u043B\u0435 ATTRIBUTIONS.txt, \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043D\u043E\u043C
    \u0432 \u043A\u043E\u0440\u043D\u0435\u0432\u043E\u0439 \u043F\u0430\u043F\u043A\u0435
    \u0418\u0433\u0440\u044B.\r\n1.4. \u041F\u0440\u0430\u0432\u043E \u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044F
    \u043D\u0430 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435
    Third Party \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u043E\u0432:
    \u0421\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u0439 \u043A\u043E\u0434 \u0438
    \u0430\u0441\u0441\u0435\u0442\u044B \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442\u0441\u044F
    \u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044E \u043A\u0430\u043A
    \u0447\u0430\u0441\u0442\u044C \u0435\u0434\u0438\u043D\u043E\u0433\u043E \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u0430.
    \u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C \u0438\u043C\u0435\u0435\u0442
    \u043F\u0440\u0430\u0432\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C,
    \u043C\u043E\u0434\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u0438 \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u044F\u0442\u044C
    \u044D\u0442\u0438 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u044B
    \u0442\u043E\u043B\u044C\u043A\u043E \u0432 \u0440\u0430\u043C\u043A\u0430\u0445
    \u0434\u0430\u043D\u043D\u043E\u0439 \u0441\u0431\u043E\u0440\u043A\u0438 \u0418\u0433\u0440\u044B
    \u0438 \u0438\u0441\u043A\u043B\u044E\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E
    \u043D\u0430 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u0438\u0445 \u043E\u0440\u0438\u0433\u0438\u043D\u0430\u043B\u044C\u043D\u044B\u0445
    \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u0439. \u0415\u0441\u043B\u0438 \u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442 \u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u0435
    \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u044B \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E
    \u043E\u0442 \u0431\u0438\u043B\u0434\u0430 \u0438\u0433\u0440\u044B \u0438\u043B\u0438
    \u0441\u043E\u0437\u0434\u0430\u0435\u0442 \u043D\u0430 \u0438\u0445 \u043E\u0441\u043D\u043E\u0432\u0435
    \u0441\u0432\u043E\u0435\u0433\u043E \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
    \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u0430, \u0442\u043E \u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C
    \u043E\u0431\u044F\u0437\u0430\u043D \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E
    \u0441\u043E\u0431\u043B\u044E\u0434\u0430\u0442\u044C \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F
    \u0438\u0445 \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0435\u0432, \u0432\u043A\u043B\u044E\u0447\u0430\u044F
    \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0435 \u0443\u043A\u0430\u0437\u0430\u043D\u0438\u0435
    \u0430\u0432\u0442\u043E\u0440\u0441\u0442\u0432\u0430 \u0442\u0440\u0435\u0442\u044C\u0438\u0445
    \u043B\u0438\u0446.\r\n1.5. \u0414\u0430\u043D\u043D\u043E\u0435 \u0421\u043E\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u0435
    \u0440\u0435\u0433\u0443\u043B\u0438\u0440\u0443\u0435\u0442 \u0442\u043E\u043B\u044C\u043A\u043E
    \u043F\u043E\u0440\u044F\u0434\u043E\u043A \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F
    \u0433\u043E\u0442\u043E\u0432\u043E\u0433\u043E \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u0430
    (\u0431\u0438\u043B\u0434\u0430 \u0418\u0433\u0440\u044B) \u043A\u043E\u043D\u0435\u0447\u043D\u044B\u043C
    \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u0435\u043C
    \u0438 \u043D\u0435 \u043E\u0442\u043C\u0435\u043D\u044F\u0435\u0442 \u0443\u0441\u043B\u043E\u0432\u0438\u044F
    \u0432\u044B\u0448\u0435\u0443\u043A\u0430\u0437\u0430\u043D\u043D\u044B\u0445
    \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u0445 \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u0439
    \u0432 \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u0438 \u0438\u0441\u0445\u043E\u0434\u043D\u043E\u0433\u043E
    \u043A\u043E\u0434\u0430 \u0438 \u0430\u0441\u0441\u0435\u0442\u043E\u0432.\r\n2.
    \u041F\u043E\u0441\u0442\u0430\u0432\u043A\u0430 \xAB\u041A\u0410\u041A \u0415\u0421\u0422\u042C\xBB
    (AS IS)\r\n2.1. \u0418\u0433\u0440\u0430 \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u043D\u0430 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \xAB\u041A\u0410\u041A
    \u0415\u0421\u0422\u042C\xBB \u0438 \xAB\u041F\u041E \u041C\u0415\u0420\u0415
    \u0414\u041E\u0421\u0422\u0423\u041F\u041D\u041E\u0421\u0422\u0418\xBB \u0431\u0435\u0437
    \u043A\u0430\u043A\u0438\u0445-\u043B\u0438\u0431\u043E \u0433\u0430\u0440\u0430\u043D\u0442\u0438\u0439
    \u043B\u044E\u0431\u043E\u0433\u043E \u0440\u043E\u0434\u0430.\r\n2.2. \u0420\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A
    \u043F\u0440\u044F\u043C\u043E \u043E\u0442\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F
    \u043E\u0442 \u0432\u0441\u0435\u0445 \u0433\u0430\u0440\u0430\u043D\u0442\u0438\u0439,
    \u044F\u0432\u043D\u044B\u0445 \u0438\u043B\u0438 \u043F\u043E\u0434\u0440\u0430\u0437\u0443\u043C\u0435\u0432\u0430\u0435\u043C\u044B\u0445,
    \u0432\u043A\u043B\u044E\u0447\u0430\u044F, \u043D\u043E \u043D\u0435 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0438\u0432\u0430\u044F\u0441\u044C:
    \u0433\u0430\u0440\u0430\u043D\u0442\u0438\u0438 \u0442\u043E\u0432\u0430\u0440\u043D\u043E\u0439
    \u043F\u0440\u0438\u0433\u043E\u0434\u043D\u043E\u0441\u0442\u0438, \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u044F
    \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u043D\u043E\u0439 \u0446\u0435\u043B\u0438,
    \u0431\u0435\u0441\u043F\u0435\u0440\u0435\u0431\u043E\u0439\u043D\u043E\u0439
    \u0440\u0430\u0431\u043E\u0442\u044B, \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u044F
    \u043E\u0448\u0438\u0431\u043E\u043A, \u0443\u044F\u0437\u0432\u0438\u043C\u043E\u0441\u0442\u0435\u0439,
    \u0431\u0430\u0433\u043E\u0432 \u0438\u043B\u0438 \u0432\u0440\u0435\u0434\u043E\u043D\u043E\u0441\u043D\u043E\u0433\u043E
    \u043A\u043E\u0434\u0430.\r\n2.3. \u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442 \u0418\u0433\u0440\u0443
    \u043D\u0430 \u0441\u0432\u043E\u0439 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
    \u0440\u0438\u0441\u043A. \u0420\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A
    \u043D\u0435 \u0433\u0430\u0440\u0430\u043D\u0442\u0438\u0440\u0443\u0435\u0442
    \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u043C\u043E\u0441\u0442\u044C
    \u0441 \u0430\u043F\u043F\u0430\u0440\u0430\u0442\u043D\u044B\u043C \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u0438\u0435\u043C
    \u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044F \u0438\u043B\u0438
    \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u043F\u043E\u0442\u0435\u0440\u0438
    \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u043D\u044B\u0445 \u0434\u0430\u043D\u043D\u044B\u0445.\r\n2.4.
    \u0412 \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u0438 \u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u0445
    \u0430\u0441\u0441\u0435\u0442\u043E\u0432 (Third Party Assets) \u0438 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u043D\u043E\u0433\u043E
    \u0434\u0432\u0438\u0436\u043A\u0430 \u0420\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A
    \u043D\u0435 \u043D\u0435\u0441\u0435\u0442 \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u0438
    \u0437\u0430 \u043D\u0430\u043B\u0438\u0447\u0438\u0435 \u0432 \u043D\u0438\u0445
    \u0441\u043A\u0440\u044B\u0442\u044B\u0445 \u0434\u0435\u0444\u0435\u043A\u0442\u043E\u0432,
    \u0443\u044F\u0437\u0432\u0438\u043C\u043E\u0441\u0442\u0435\u0439, \u0432\u0440\u0435\u0434\u043E\u043D\u043E\u0441\u043D\u043E\u0433\u043E
    \u043A\u043E\u0434\u0430 \u0438\u043B\u0438 \u043D\u0430\u0440\u0443\u0448\u0435\u043D\u0438\u044F
    \u043F\u0440\u0430\u0432 \u0438\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442\u0443\u0430\u043B\u044C\u043D\u043E\u0439
    \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u0438
    \u0442\u0440\u0435\u0442\u044C\u0438\u0445 \u043B\u0438\u0446, \u0432\u043E\u0437\u043D\u0438\u043A\u0448\u0438\u0445
    \u043F\u043E \u0432\u0438\u043D\u0435 \u0438\u0445 \u043F\u0435\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u044B\u0445
    \u0430\u0432\u0442\u043E\u0440\u043E\u0432.\r\n3. \u041E\u0442\u043A\u0430\u0437
    \u043E\u0442 \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u0438
    \u0438 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0438\u0435 \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u0438\r\n3.1.
    \u041D\u0438 \u043F\u0440\u0438 \u043A\u0430\u043A\u0438\u0445 \u043E\u0431\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430\u0445
    \u0420\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A, \u0435\u0433\u043E
    \u043F\u0430\u0440\u0442\u043D\u0435\u0440\u044B, \u0434\u0438\u0441\u0442\u0440\u0438\u0431\u044C\u044E\u0442\u043E\u0440\u044B
    \u0438\u043B\u0438 \u0430\u0432\u0442\u043E\u0440\u044B \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0433\u043E
    \u043A\u043E\u0434\u0430 \u043D\u0435 \u043D\u0435\u0441\u0443\u0442 \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u0438
    \u0437\u0430 \u043B\u044E\u0431\u044B\u0435 \u043F\u0440\u044F\u043C\u044B\u0435,
    \u043A\u043E\u0441\u0432\u0435\u043D\u043D\u044B\u0435, \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0435,
    \u043E\u0441\u043E\u0431\u044B\u0435, \u0448\u0442\u0440\u0430\u0444\u043D\u044B\u0435
    \u0438\u043B\u0438 \u043F\u043E\u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435
    \u0443\u0431\u044B\u0442\u043A\u0438 (\u0432\u043A\u043B\u044E\u0447\u0430\u044F,
    \u043D\u043E \u043D\u0435 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0438\u0432\u0430\u044F\u0441\u044C:
    \u0443\u043F\u0443\u0449\u0435\u043D\u043D\u0443\u044E \u0432\u044B\u0433\u043E\u0434\u0443,
    \u043F\u043E\u0442\u0435\u0440\u044E \u0434\u0430\u043D\u043D\u044B\u0445, \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435
    \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F, \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0432\u0440\u0435\u0434 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044E \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044F),
    \u0432\u043E\u0437\u043D\u0438\u043A\u0448\u0438\u0435 \u0432 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0435
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F
    \u0438\u043B\u0438 \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0438
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F
    \u0418\u0433\u0440\u044B, \u0434\u0430\u0436\u0435 \u0435\u0441\u043B\u0438 \u0420\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A
    \u0431\u044B\u043B \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D
    \u043E \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0438 \u0442\u0430\u043A\u0438\u0445
    \u0443\u0431\u044B\u0442\u043A\u043E\u0432.\r\n3.2. \u041E\u0431\u0449\u0430\u044F
    \u0441\u043E\u0432\u043E\u043A\u0443\u043F\u043D\u0430\u044F \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C
    \u0420\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A\u0430 \u043F\u0435\u0440\u0435\u0434
    \u0432\u0430\u043C\u0438 \u043F\u043E \u043B\u044E\u0431\u043E\u043C\u0443 \u0438\u0441\u043A\u0443
    \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u0441\u0443\u043C\u043C\u043E\u0439 \u0432 \u043E\u0434\u0438\u043D \u0440\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u0438\u0439
    \u0440\u0443\u0431\u043B\u044C (1 RUB).\r\n4. \u041C\u0435\u0434\u0438\u0446\u0438\u043D\u0441\u043A\u0438\u0439
    \u043E\u0442\u043A\u0430\u0437 \u043E\u0442 \u043F\u0440\u0435\u0442\u0435\u043D\u0437\u0438\u0439
    (\u042D\u043F\u0438\u043B\u0435\u043F\u0441\u0438\u044F \u0438 \u0441\u0432\u0435\u0442\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C)\r\n4.1.
    \u0412\u041D\u0418\u041C\u0410\u041D\u0418\u0415: \u0418\u0433\u0440\u0430 \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442
    \u0431\u044B\u0441\u0442\u0440\u043E \u043C\u0438\u0433\u0430\u044E\u0449\u0438\u0435
    \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u044F, \u044F\u0440\u043A\u0438\u0435
    \u0432\u0441\u043F\u044B\u0448\u043A\u0438 \u0441\u0432\u0435\u0442\u0430, \u0441\u0442\u0440\u043E\u0431\u043E\u0441\u043A\u043E\u043F\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u044D\u0444\u0444\u0435\u043A\u0442\u044B, \u0440\u0435\u0437\u043A\u0438\u0435
    \u0441\u043C\u0435\u043D\u044B \u043A\u043E\u043D\u0442\u0440\u0430\u0441\u0442\u0430
    \u0438 \u0432\u0438\u0437\u0443\u0430\u043B\u044C\u043D\u044B\u0439 \u0448\u0443\u043C.\r\n4.2.
    \u041F\u0435\u0440\u0435\u0434 \u043D\u0430\u0447\u0430\u043B\u043E\u043C \u0438\u0433\u0440\u044B
    \u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442,
    \u0447\u0442\u043E:\r\n\u2022 \u0423 \u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044F
    \u043D\u0435\u0442 \u0434\u0438\u0430\u0433\u043D\u043E\u0441\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0439
    \u044D\u043F\u0438\u043B\u0435\u043F\u0441\u0438\u0438, \u0444\u043E\u0442\u043E\u0441\u0435\u043D\u0441\u0438\u0442\u0438\u0432\u043D\u043E\u0439
    \u044D\u043F\u0438\u043B\u0435\u043F\u0441\u0438\u0438 \u0438\u043B\u0438 \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u043E\u0439
    \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
    \u043A \u0441\u0432\u0435\u0442\u0443;\r\n\u2022 \u0415\u0441\u043B\u0438 \u0443
    \u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044F \u0435\u0441\u0442\u044C
    \u043F\u043E\u0434\u043E\u0431\u043D\u044B\u0435 \u0434\u0438\u0430\u0433\u043D\u043E\u0437\u044B
    \u0438\u043B\u0438 \u043F\u0440\u0435\u0434\u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043D\u043E\u0441\u0442\u044C,
    \u0432\u044B \u043F\u0440\u043E\u043A\u043E\u043D\u0441\u0443\u043B\u044C\u0442\u0438\u0440\u043E\u0432\u0430\u043B\u0438\u0441\u044C
    \u0441 \u043A\u0432\u0430\u043B\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C
    \u0432\u0440\u0430\u0447\u043E\u043C \u0438 \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0438
    \u043F\u0438\u0441\u044C\u043C\u0435\u043D\u043D\u043E\u0435 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435
    \u043D\u0430 \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435
    \u0441 \u043F\u043E\u0434\u043E\u0431\u043D\u044B\u043C \u043A\u043E\u043D\u0442\u0435\u043D\u0442\u043E\u043C;\r\n\u2022
    \u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442\u0435
    \u0438\u0433\u0440\u0443 \u0432 \u0445\u043E\u0440\u043E\u0448\u043E \u043E\u0441\u0432\u0435\u0449\u0435\u043D\u043D\u043E\u043C
    \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u0438 \u043D\u0430 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u043C
    \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0438 \u043E\u0442 \u044D\u043A\u0440\u0430\u043D\u0430
    \u043D\u0430 \u0441\u0432\u043E\u0439 \u0441\u0442\u0440\u0430\u0445 \u0438 \u0440\u0438\u0441\u043A.\r\n4.3.
    \u041F\u0440\u0438 \u0432\u043E\u0437\u043D\u0438\u043A\u043D\u043E\u0432\u0435\u043D\u0438\u0438
    \u0433\u043E\u043B\u043E\u0432\u043E\u043A\u0440\u0443\u0436\u0435\u043D\u0438\u044F,
    \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F \u0437\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
    \u0432\u043E\u0441\u043F\u0440\u0438\u044F\u0442\u0438\u044F, \u0442\u043E\u0448\u043D\u043E\u0442\u044B
    \u0438\u043B\u0438 \u0438\u043D\u044B\u0445 \u043D\u0435\u0434\u043E\u043C\u043E\u0433\u0430\u043D\u0438\u0439
    \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E \u043F\u0440\u0435\u043A\u0440\u0430\u0442\u0438\u0442\u0435
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435
    \u0418\u0433\u0440\u044B.\r\n5. \u0418\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442\u0443\u0430\u043B\u044C\u043D\u0430\u044F
    \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C
    \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430\r\n5.1. \u0412\u0441\u0435
    \u043E\u0440\u0438\u0433\u0438\u043D\u0430\u043B\u044C\u043D\u044B\u0435 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0438,
    \u0438\u043C\u0435\u043D\u0430, \u043B\u043E\u043A\u0430\u0446\u0438\u0438 \u0438
    \u0441\u044E\u0436\u0435\u0442\u043D\u044B\u0435 \u043B\u0438\u043D\u0438\u0438,
    \u0441\u043E\u0437\u0434\u0430\u043D\u043D\u044B\u0435 \u043D\u0435\u043F\u043E\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u043E
    \u0420\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A\u043E\u043C
    \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E \u0434\u043B\u044F
    \u0434\u0430\u043D\u043D\u043E\u0433\u043E \u043F\u0440\u043E\u0435\u043A\u0442\u0430,
    \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E
    \u0432\u044B\u043C\u044B\u0448\u043B\u0435\u043D\u043D\u044B\u043C\u0438.\r\n5.2.
    \u041B\u044E\u0431\u044B\u0435 \u0441\u043E\u0432\u043F\u0430\u0434\u0435\u043D\u0438\u044F
    \u0441 \u0440\u0435\u0430\u043B\u044C\u043D\u044B\u043C\u0438 \u043B\u044E\u0434\u044C\u043C\u0438,
    \u0436\u0438\u0432\u044B\u043C\u0438 \u0438\u043B\u0438 \u0443\u043C\u0435\u0440\u0448\u0438\u043C\u0438,
    \u0441\u043E\u0431\u044B\u0442\u0438\u044F\u043C\u0438 \u0438\u043B\u0438 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u044F\u043C\u0438
    \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E
    \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u043C\u0438 \u0438 \u043D\u0435\u043F\u0440\u0435\u0434\u043D\u0430\u043C\u0435\u0440\u0435\u043D\u043D\u044B\u043C\u0438.\r\n6.
    \u0421\u0431\u043E\u0440 \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0434\u0430\u043D\u043D\u044B\u0445 \u0438 \u0440\u043E\u043B\u044C \u0438\u0433\u0440\u043E\u0432\u043E\u0433\u043E
    \u0434\u0432\u0438\u0436\u043A\u0430\r\n6.1. \u0418\u0433\u0440\u043E\u0432\u043E\u0439
    \u043A\u043B\u0438\u0435\u043D\u0442 \u0441\u043E\u0441\u0442\u043E\u0438\u0442
    \u0438\u0437 \u0434\u0432\u0443\u0445 \u0447\u0430\u0441\u0442\u0435\u0439: \u043E\u0440\u0438\u0433\u0438\u043D\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0433\u043E \u043A\u043E\u0434\u0430
    (\u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043D\u043E\u0433\u043E \u0420\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A\u043E\u043C)
    \u0438 \u0437\u0430\u043A\u0440\u044B\u0442\u043E\u0433\u043E \u0431\u0438\u043D\u0430\u0440\u043D\u043E\u0433\u043E
    \u043A\u043E\u0434\u0430 \u0438\u0433\u0440\u043E\u0432\u043E\u0433\u043E \u0434\u0432\u0438\u0436\u043A\u0430
    Unity 6\r\n6.2. \u041E\u0440\u0438\u0433\u0438\u043D\u0430\u043B\u044C\u043D\u044B\u0439
    \u043A\u043E\u0434: \u0420\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A
    \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u043C \u0437\u0430\u0432\u0435\u0440\u044F\u0435\u0442,
    \u0447\u0442\u043E \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043D\u044B\u0439
    \u0438\u0441\u0445\u043E\u0434\u043D\u044B\u0439 \u043A\u043E\u0434 \u0418\u0433\u0440\u044B
    \u043D\u0435 \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442
    \u0441\u0431\u043E\u0440 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0445
    \u0434\u0430\u043D\u043D\u044B\u0445, \u0442\u0435\u043B\u0435\u043C\u0435\u0442\u0440\u0438\u0438
    \u0438\u043B\u0438 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438
    \u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F\u0445 \u041F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044F.\r\n6.3.
    \u0418\u0433\u0440\u043E\u0432\u043E\u0439 \u0434\u0432\u0438\u0436\u043E\u043A:
    \u0418\u0433\u0440\u0430 \u0441\u043E\u0437\u0434\u0430\u043D\u0430 \u043D\u0430
    \u0431\u0430\u0437\u0435 \u043F\u0440\u043E\u043F\u0440\u0438\u0435\u0442\u0430\u0440\u043D\u043E\u0433\u043E
    \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u043D\u043E\u0433\u043E \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u0438\u044F
    Unity Engine. \u0418\u0441\u043F\u043E\u043B\u043D\u044F\u0435\u043C\u044B\u0439
    \u0444\u0430\u0439\u043B \u043C\u043E\u0436\u0435\u0442 \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u0442\u044C
    \u0432\u0441\u0442\u0440\u043E\u0435\u043D\u043D\u044B\u0435 \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C\u044B
    \u0441\u0431\u043E\u0440\u0430 \u0430\u043D\u043E\u043D\u0438\u043C\u043D\u043E\u0439
    \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u0442\u0435\u043B\u0435\u043C\u0435\u0442\u0440\u0438\u0438
    \u0441\u0430\u043C\u043E\u0433\u043E \u0434\u0432\u0438\u0436\u043A\u0430 (\u0432\u0435\u0440\u0441\u0438\u044F
    \u041E\u0421, \u043C\u043E\u0434\u0435\u043B\u044C \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430,
    \u0447\u0430\u0441\u0442\u043E\u0442\u0430 \u043A\u0430\u0434\u0440\u043E\u0432,
    \u0441\u0431\u043E\u0438 \u0440\u0435\u043D\u0434\u0435\u0440\u0438\u043D\u0433\u0430,
    \u0434\u0430\u043D\u043D\u044B\u0435 \u043E\u0431 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0438
    \u0441\u0438\u0441\u0442\u0435\u043C \u0432\u0432\u043E\u0434\u0430). \u0414\u0430\u043D\u043D\u044B\u0439
    \u0441\u0431\u043E\u0440 \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u043D\u0430\u043F\u0440\u044F\u043C\u0443\u044E \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0435\u0439
    Unity Technologies \u0441\u043E\u0433\u043B\u0430\u0441\u043D\u043E \u0435\u0435
    \u041F\u043E\u043B\u0438\u0442\u0438\u043A\u0435 \u043A\u043E\u043D\u0444\u0438\u0434\u0435\u043D\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438
